---
import Base from '../../layouts/Base.astro';
import { getCollection, getEntry } from 'astro:content';
export async function getStaticPaths() {
  const paths = await getCollection('paths');
  return paths.map((p) => ({ params: { id: p.id }, props: { p } }));
}
const { p } = Astro.props;
const phases = await Promise.all(p.data.phases.map(async (ph) => ({
  ...ph,
  steps: await Promise.all(ph.steps.map(async (s) => {
    const m = await getEntry('modules', s.module);
    if (!m) throw new Error(`Path ${p.id}: unknown module ${s.module}`);
    return { ...s, m };
  })),
})));
const total = phases.reduce((n, ph) => n + ph.steps.length, 0);
---
<Base title={p.data.title} description={p.data.intro}>
  <span class="pill">{p.data.purchase}</span>
  <h1 class="mt-4 text-4xl font-extrabold leading-tight md:text-5xl">{p.data.title}</h1>
  <p class="mt-4 text-lg muted">{p.data.intro}</p>
  {p.data.storeUrl && <p class="mt-2 text-sm rich"><a href={p.data.storeUrl}>Store page</a></p>}

  <div class="well mt-8 flex items-center gap-4 text-sm muted">
    <span><b class="text-2xl font-bold text-success" data-done>0</b> / {total} done</span>
    <div class="h-1.5 flex-1 overflow-hidden rounded-full bg-white/10"><i class="block h-full bg-success transition-[width]" style="width:0" data-bar></i></div>
    <button class="rounded-lg bg-white/10 px-2.5 py-1 text-xs font-semibold text-white hover:bg-white/15" data-reset>reset</button>
  </div>

  {phases.map((ph, i) => (
    <section class="mt-12">
      {ph.when && <div class="text-xs font-bold uppercase tracking-widest text-secondary-text">{ph.when}</div>}
      <h2 class="mt-1 text-2xl font-extrabold">{i + 1}. {ph.title}</h2><div class="underline-bar"></div>
      <div class="mt-4 space-y-3">
        {ph.steps.map((s) => (
          <label class="card flex cursor-pointer gap-4 has-[:checked]:opacity-55" data-step={`${p.id}:${s.module}`}>
            <input type="checkbox" class="mt-1.5 size-5 shrink-0 accent-success" aria-label={`Done: ${s.m.data.title}`} />
            <div class="min-w-0">
              <h3 class="font-bold"><a class="hover:underline" href={`/modules/${s.module}`}>{s.m.data.title}</a> {s.optional && <span class="ml-1 text-xs font-semibold uppercase tracking-wide muted">optional</span>}</h3>
              <p class="mt-1 flex flex-wrap gap-1.5"><span class="chip">{s.m.data.time}</span><span class="chip">{s.m.data.format}</span>{s.m.data.access && <a class="chip hover:bg-white/15" href={s.m.data.access}>open ↗</a>}</p>
              {s.note && <p class="mt-2 text-sm text-white/85">{s.note}</p>}
            </div>
          </label>
        ))}
      </div>
    </section>
  ))}
  {p.data.next && <div class="callout mt-12" set:html={p.data.next} />}
  <p class="mt-6 text-sm muted rich">Stuck? <a href="/help">Help</a>. Liked it? <a href="/affiliate">Earn 40% recommending it</a>.</p>
  <script>
    const key = 'lp:' + location.pathname;
    const steps = [...document.querySelectorAll<HTMLElement>('[data-step]')];
    const load = (): Record<string, boolean> => { try { return JSON.parse(localStorage.getItem(key) || '{}'); } catch { return {}; } };
    let state = load();
    const paint = () => {
      let done = 0;
      steps.forEach((el) => { const on = !!state[el.dataset.step!]; (el.querySelector('input') as HTMLInputElement).checked = on; if (on) done++; });
      document.querySelector('[data-done]')!.textContent = String(done);
      (document.querySelector('[data-bar]') as HTMLElement).style.width = steps.length ? `${(100 * done) / steps.length}%` : '0';
    };
    steps.forEach((el) => el.querySelector('input')!.addEventListener('change', (e) => { state[el.dataset.step!] = (e.target as HTMLInputElement).checked; try { localStorage.setItem(key, JSON.stringify(state)); } catch {} paint(); }));
    document.querySelector('[data-reset]')!.addEventListener('click', () => { state = {}; try { localStorage.removeItem(key); } catch {} paint(); });
    paint();
  </script>
</Base>
