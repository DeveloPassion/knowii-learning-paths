---
import '../styles/global.css';
interface Props { title: string; description?: string }
const { title, description = 'Learning paths for Knowii and DeveloPassion customers.' } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title} · Knowii Learning Paths</title>
  <meta name="description" content={description} />
  <meta name="robots" content="index,follow" />
</head>
<body>
  <header class="site"><div class="wrap">
    <a class="brand" href="/">Knowii <span>Learning Paths</span></a>
    <nav><a href="/modules">Modules</a> · <a href="/knowii">Knowii</a> · <a href="/free">Free</a> · <a href="/help">Help</a></nav>
  </div></header>
  <main class="wrap"><slot /></main>
  <footer class="site"><div class="wrap">
    Made by <a href="https://dsebastien.net">Sébastien Dubois</a> (<a href="https://www.dsebastien.net/blog/">articles</a>, <a href="https://www.dsebastien.net/newsletter/">newsletter</a>, <a href="https://www.dsebastien.net/news/">news</a>) · <a href="/knowii">How Knowii is organized</a> · <a href="https://store.dsebastien.net">Store</a> · <a href="https://www.knowii.net">Knowii</a> · <a href="https://tools.dsebastien.net">Tools</a> · <a href="/free">Free resources</a> · <a href="/affiliate">Affiliate program</a> · <a href="/help">Help</a> · <a href="mailto:sebastien@developassion.be">sebastien@developassion.be</a>
  </div></footer>
</body>
</html>
